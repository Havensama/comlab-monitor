@startuml UE_CompLab_Class_Diagram_Simple
' Slide-friendly class diagram: main classes only.
' The full version (every class and method) is in 3-class-diagram.puml.
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #3F3F46
skinparam ArrowFontSize 12
skinparam ClassBorderThickness 1.4
skinparam nodesep 60
skinparam ranksep 70
hide circle
hide empty members
left to right direction

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #52525B
  HeaderBackgroundColor #F4F4F5
}

class StudentApp #FFF4EC;line:F47A20 {
  - student : Student
  - session : LabSession
  + login(studentNo, password)
  + submitCheck(monitor, keyboard, mouse)
  + reportIssue(category, priority, description)
  + logout()
}

class KioskGuard #FFF4EC;line:F47A20 {
  + engage()
  + release()
}

class AdminApp #F3EEFF;line:7C3AED {
  + login(username, password)
  + viewDashboard()
  + viewSessions()
  + resolveReport(reportId)
}

class Database #EEF6FF;line:2563EB {
  + getConnection()
  + sha256(text) : String
}

class Student #F0FDF4;line:16A34A {
  - studentNo : String
  - fullName : String
  - course : String
  - passwordHash : String
}

class Admin #F0FDF4;line:16A34A {
  - username : String
  - fullName : String
  - passwordHash : String
}

class Pc #F0FDF4;line:16A34A {
  - pcId : String
  - location : String
  - lastSeen : DateTime
  + isOnline() : boolean
}

class LabSession #F0FDF4;line:16A34A {
  - sessionId : int
  - timeIn : DateTime
  - timeOut : DateTime
  + duration() : long
  + isActive() : boolean
}

class EquipmentCheck #F0FDF4;line:16A34A {
  - monitorOk : boolean
  - keyboardOk : boolean
  - mouseOk : boolean
}

class Report #F0FDF4;line:16A34A {
  - reportId : int
  - category : String
  - priority : String
  - description : String
  - status : String
  + resolve()
}

StudentApp *-- KioskGuard : locks screen
StudentApp --> Database : saves to
AdminApp --> Database : reads from
AdminApp ..> Admin : signs in as
StudentApp ..> Student : signs in as

Student "1" -- "0..*" LabSession : has
Pc "1" -- "0..*" LabSession : used in
LabSession "1" *-- "0..1" EquipmentCheck : has
LabSession "0..1" -- "0..*" Report : produces
Pc "1" -- "0..*" Report : has issues
@enduml
