@startuml UE_CompLab_Class_Diagram
title UE CompLab Monitoring System — Class Diagram
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
hide empty members

package "ph.ue.comlab" #FAFAFA {
  class Launcher {
    +main(args: String[]): void
  }
  class AppConfig {
    -P: Properties
    +load(): void
    +get(key, def): String
    +getInt(key, def): int
    +getBool(key, def): boolean
    +pcId(): String
    +pcLocation(): String
  }
}

package "ph.ue.comlab.student" #FFF4EC {
  class StudentApp {
    -students: StudentDao
    -sessions: SessionDao
    -reports: ReportDao
    -pcs: PcDao
    -guard: KioskGuard
    -login: LoginPanel
    -check: WorkstationCheckPanel
    -bar: SessionBar
    -student: Student
    -session: LabSession
    +start(): void
    -heartbeat(): void
    -doLogin(id, password): void
    -beginUse(monitorOk, keyboardOk, mouseOk, concern): void
    -unlock(): void
    -reportDuringSession(): void
    -confirmLogout(): void
    -lockForNextStudent(): void
    -secretExit(): void
  }
  class KioskGuard {
    -frame: JFrame
    -lock: boolean
    -engaged: boolean
    +engage(): void
    +release(): void
    +isEngaged(): boolean
    -pullToFront(): void
  }
  class WorkstationCheckPanel {
    -monitor, keyboard, mouse: EquipmentCard
    -concern: ConcernForm
    +setListener(l): void
    +concernSent(recent): void
    +setRecentReports(list): void
    +showError(msg): void
  }
  class SessionBar {
    -timer: JLabel
    +open(): void
    +close(): void
  }
  class ReportDialog {
    -form: ConcernForm
    +failed(msg): void
  }
}

package "ph.ue.comlab.admin" #F3EEFF {
  class AdminApp {
    -login: LoginPanel
    -pageMap: Map<String, Page>
    -refresher: Timer
    +start(): void
    -doLogin(user, password): void
    -openShell(admin): void
    -go(page): void
    -refresh(): void
    -pcClicked(pc): void
    -logout(): void
  }
  interface Page<D> {
    +view(): JComponent
    +load(): D
    +show(data: D): void
  }
  class DashboardPage {
    -pcDao: PcDao
    -reportDao: ReportDao
    +load(): Data
    +show(d: Data): void
  }
  class SessionsPage {
    -dao: SessionDao
    +load(): List<SessionRow>
    -endSelected(): void
    -exportCsv(): void
  }
  class ReportsPage {
    -dao: ReportDao
    +load(): List<Report>
    -showDetail(r): void
    -setStatus(r, status): void
  }
  class StudentsPage {
    -dao: StudentDao
    +load(): List<Student>
    -addStudent(): void
    -resetPassword(): void
  }
}

package "ph.ue.comlab.ui" #FAFAFA {
  class LoginPanel {
    -copy: Copy
    +onLogin(h): void
    +showError(msg): void
    +reset(): void
  }
  class ConcernForm {
    -category: Select
    -priority: Segmented
    -photo: byte[]
    +validateInput(): String
    +value(): Concern
    +clear(): void
  }
}

package "ph.ue.comlab.db" #EEF6FF {
  class Database {
    +get(): Connection
    +ping(): boolean
    +explain(e): String
    +sha256(text): String
  }
  class StudentDao {
    +login(studentNo, password): Optional<Student>
    +adminLogin(user, password): Optional<Admin>
    +all(search): List<Student>
    +add(no, name, course, pw): void
    +resetPassword(no, pw): void
  }
  class SessionDao {
    +activeElsewhere(no, pc): Optional<String>
    +start(no, pc): LabSession
    +end(id, reason): void
    +isClosed(id): boolean
    +saveEquipmentCheck(id, m, k, mouse): void
    +log(search, active, today): List<SessionRow>
  }
  class ReportDao {
    +create(...): void
    +recentForPc(pc, limit): List<Report>
    +list(status, search): List<Report>
    +setStatus(id, status): void
    +photo(id): byte[]
  }
  class PcDao {
    +heartbeat(pc, location): void
    +markOffline(pc): void
    +all(): List<PcStatus>
    +stats(): Stats
  }
}

package "ph.ue.comlab.model" #F0FDF4 {
  class Student <<record>> {
    studentNo: String
    fullName: String
    course: String
    +initials(): String
  }
  class Admin <<record>> {
    username: String
    fullName: String
  }
  class LabSession <<record>> {
    sessionId: int
    studentNo: String
    pcId: String
    timeIn: LocalDateTime
    timeOut: LocalDateTime
  }
  class Report <<record>> {
    reportId: int
    pcId: String
    category: String
    priority: String
    status: String
    createdAt: LocalDateTime
    +title(): String
  }
  class PcStatus <<record>> {
    pcId: String
    online: boolean
    currentStudentName: String
    sessionSeconds: long
    openReports: int
  }
  class SessionRow <<record>> {
    sessionId: int
    studentName: String
    pcId: String
    timeIn / timeOut
    monitorOk, keyboardOk, mouseOk
    +active(): boolean
  }
}

Launcher ..> StudentApp : starts
Launcher ..> AdminApp : starts
StudentApp *-- KioskGuard
StudentApp *-- LoginPanel
StudentApp *-- WorkstationCheckPanel
StudentApp *-- SessionBar
StudentApp ..> ReportDialog : opens
WorkstationCheckPanel *-- ConcernForm
ReportDialog *-- ConcernForm
AdminApp *-- LoginPanel
AdminApp o-- Page : 4 pages
DashboardPage ..|> Page
SessionsPage ..|> Page
ReportsPage ..|> Page
StudentsPage ..|> Page
StudentApp --> StudentDao
StudentApp --> SessionDao
StudentApp --> ReportDao
StudentApp --> PcDao
DashboardPage --> PcDao
SessionsPage --> SessionDao
ReportsPage --> ReportDao
StudentsPage --> StudentDao
StudentDao ..> Database
SessionDao ..> Database
ReportDao ..> Database
PcDao ..> Database
Database ..> AppConfig : reads
StudentDao ..> Student : returns
StudentDao ..> Admin
SessionDao ..> LabSession : returns
SessionDao ..> SessionRow
ReportDao ..> Report : returns
PcDao ..> PcStatus : returns
@enduml